# Alpaca API credentials
# Sign up at https://alpaca.markets and copy your key and secret here.
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Set to "false" to use the live trading endpoint (REAL MONEY).
# Leave as "true" (default) to use paper trading.
ALPACA_PAPER=true
